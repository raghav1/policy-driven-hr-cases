# Copy to .env and fill in. Never commit .env.

# Key ServiceNow sends in the X-API-Key header. Generate with: openssl rand -hex 32
SERVICE_API_KEY=

# LLM provider: "anthropic", or "offline" to run without a key (deterministic stand-in)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Where policy articles come from: "local" (./corpus, for development) or "servicenow"
KB_SOURCE=local

# ServiceNow read-only integration user (needed when KB_SOURCE=servicenow and for get_case)
SN_INSTANCE_URL=https://devNNNNN.service-now.com
SN_USER=
SN_PASSWORD=
SN_HR_KB_SYS_ID=
SN_CASE_TABLE=x_2312287_hrorch_hr_case

# Public address of this service, used by the gateway (docker compose --profile public up)
PUBLIC_HOST=
